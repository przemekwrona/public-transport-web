{
  "id": "public-transport",
  "realm": "public-transport",
  "displayName": "Public transport",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 36000,
  "ssoSessionIdleTimeout": 36000,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "client": {
      "public-transport-web": [
        {
          "name": "SUPER_USER",
          "description": "Role for system owner",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "AGENCY_OWNER",
          "description": "Role for the owner of a transit agency",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "AGENCY_ADMIN",
          "description": "Role for the administrator of a transit agency",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "PLANNER",
          "description": "Role for the planner of lines, routes and timetables",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "BRIGADIER",
          "description": "Role for the brigadier",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "DISPATCHER",
          "description": "Role for the dispatcher",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "DRIVER",
          "description": "Role for the driver",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "id": "c0ffee00-0000-4000-8000-000000000001",
      "clientId": "public-transport-web",
      "name": "Public transport",
      "description": "Roles are granted per agency group /agencies/{agencyCode}/{role}. A role in one agency does not apply to another.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "public-transport-web-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ],
      "protocolMappers": [
        {
          "name": "agency-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "agencies",
      "path": "/agencies",
      "subGroups": [
        {
          "name": "NEXTSTOP",
          "path": "/agencies/NEXTSTOP",
          "subGroups": [
            {
              "name": "SUPER_USER",
              "path": "/agencies/NEXTSTOP/SUPER_USER"
            },
            {
              "name": "AGENCY_OWNER",
              "path": "/agencies/NEXTSTOP/AGENCY_OWNER"
            },
            {
              "name": "AGENCY_ADMIN",
              "path": "/agencies/NEXTSTOP/AGENCY_ADMIN"
            },
            {
              "name": "PLANNER",
              "path": "/agencies/NEXTSTOP/PLANNER"
            },
            {
              "name": "BRIGADIER",
              "path": "/agencies/NEXTSTOP/BRIGADIER"
            },
            {
              "name": "DISPATCHER",
              "path": "/agencies/NEXTSTOP/DISPATCHER"
            },
            {
              "name": "DRIVER",
              "path": "/agencies/NEXTSTOP/DRIVER"
            }
          ]
        }
      ]
    }
  ],
  "users": [
    {
      "username": "pwrona",
      "email": "biuro@nastepnastacja.pl",
      "enabled": true,
      "emailVerified": true,
      "groups": [
        "/agencies/NEXTSTOP",
        "/agencies/NEXTSTOP/SUPER_USER",
        "/agencies/NEXTSTOP/AGENCY_OWNER"
      ],
      "credentials": [
        {
          "type": "password",
          "temporary": false,
          "value": "welcome1"
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "id": "c0ffee00-0000-4000-8000-000000000020",
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}

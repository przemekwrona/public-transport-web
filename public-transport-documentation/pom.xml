<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pl.wrona</groupId>
        <artifactId>public-transport-web</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>public-transport-documentation</artifactId>
    <packaging>pom</packaging>
    <name>public-transport-documentation</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <asciidoctor.maven.plugin.version>3.2.0</asciidoctor.maven.plugin.version>
        <asciidoctorj.pdf.version>2.3.23</asciidoctorj.pdf.version>
        <docs.output>${project.build.directory}/docs</docs.output>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <version>${asciidoctor.maven.plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-pdf</artifactId>
                        <version>${asciidoctorj.pdf.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <sourceDocumentName>main.adoc</sourceDocumentName>
                </configuration>
                <executions>
                    <execution>
                        <id>user-html</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/docs/user</sourceDirectory>
                            <outputDirectory>${docs.output}/user</outputDirectory>
                            <backend>html5</backend>
                            <attributes>
                                <!-- Enables the left-hand sidebar table of contents -->
                                <toc>left</toc>
                                <toclevels>3</toclevels>
                                <icons>font</icons>
                                <source-highlighter>highlightjs</source-highlighter>
                            </attributes>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/docs/user</directory>
                                    <includes>
                                        <include>**/*.png</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>user-pdf</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/docs/user</sourceDirectory>
                            <outputDirectory>${docs.output}/user</outputDirectory>
                            <backend>pdf</backend>
                        </configuration>
                    </execution>
                    <execution>
                        <id>client-html</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/docs/user</sourceDirectory>
                            <outputDirectory>${project.basedir}/../public-transport-web-client/src/app/generated-doc</outputDirectory>
                            <backend>html5</backend>
                            <attributes>
                                <!-- Enables the left-hand sidebar table of contents -->
                                <toc>left</toc>
                                <toclevels>3</toclevels>
                                <icons>font</icons>
                                <source-highlighter>highlightjs</source-highlighter>
                            </attributes>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/docs/user</directory>
                                    <includes>
                                        <include>**/*.png</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>technical-html</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/docs/technical</sourceDirectory>
                            <outputDirectory>${docs.output}/technical</outputDirectory>
                            <backend>html5</backend>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/docs/technical/images</directory>
                                    <targetPath>images</targetPath>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>technical-pdf</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>${project.basedir}/src/docs/technical</sourceDirectory>
                            <outputDirectory>${docs.output}/technical</outputDirectory>
                            <backend>pdf</backend>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
